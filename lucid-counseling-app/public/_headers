# Hashed, content-addressed build output (index-<hash>.js/.css) — the name
# changes whenever the content does, so it's safe to cache forever. Only Vite's
# bundles live here; images live under /media/ precisely so they DON'T get this.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images and other files with fixed names (logo, headshots, scene renders).
# Replacing one keeps the same URL, so browsers must re-check: cache for an hour,
# then revalidate (ETags make that a cheap 304 when nothing changed).
/media/*
  Cache-Control: public, max-age=3600, must-revalidate

# Sensible security defaults for every route.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'
